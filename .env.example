# API
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ledgerlite
PORT=3000
# Dev API key. If set, every route except /health requires header x-api-key.
API_KEY=dev-key
# Comma-separated list of allowed browser origins (unset = allow all, dev only)
CORS_ORIGIN=http://localhost:5173
# Web (Vite)
VITE_API_URL=/api
VITE_API_KEY=dev-key
