{
  "name": "ledgerlite",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm --filter @ledgerlite/shared build && pnpm --filter @ledgerlite/api test",
    "typecheck": "pnpm --filter @ledgerlite/shared build && pnpm -r typecheck",
    "dev:api": "pnpm --filter @ledgerlite/api dev",
    "dev:web": "pnpm --filter @ledgerlite/web dev",
    "migrate": "pnpm --filter @ledgerlite/api migrate",
    "seed": "pnpm --filter @ledgerlite/api seed"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}